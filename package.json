{
  "name": "drop-gse",
  "version": "0.3.0",
  "private": true,
  "description": "Drop addon: automated P2P multiplayer over mesh VPNs via Steam emulator wrappers",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "bundle:build": "drop-plugin build plugin-bundle",
    "validate": "drop-plugin validate plugin-bundle",
    "sign": "drop-plugin sign plugin-bundle",
    "pack": "drop-plugin pack plugin-bundle dist-packages"
  },
  "devDependencies": {
    "@droposs/plugin-cli": "^0.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^10.9.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=20"
  }
}
